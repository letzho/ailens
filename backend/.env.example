# ---------- OpenAI (required) ----------
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini          # fast text answers (advisor / general)
OPENAI_VISION_MODEL=gpt-4o             # camera / object / resistor reading
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe   # or whisper-1

# ---------- Tavily (optional: scrape NYP SEG website) ----------
TAVILY_API_KEY=tvly-...
SEG_URL=https://www.nyp.edu.sg/student/study/schools/engineering
# Extra pages to ingest, comma separated (optional)
EXTRA_URLS=

# ---------- Pinecone (optional: RAG vector store) ----------
PINECONE_API_KEY=
PINECONE_INDEX=ai-lens-seg
PINECONE_NAMESPACE=open-house-2027
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------- Supabase (optional: interaction log) ----------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Voice (text-to-speech) ----------
# auto = ElevenLabs if a key is set, else OpenAI voice, else the browser's own voice
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_STYLE=Warm, friendly and natural, like a helpful Singaporean student ambassador. Clear, not too fast.

# ---------- Access PIN (who may use the lens) ----------
# Anyone without this PIN is blocked from the app and from every AI endpoint.
APP_PIN=123456
# Long random string used to sign login cookies (required on Vercel).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# How long a login lasts (hours)
AUTH_TTL_HOURS=12

# ---------- Server ----------
PORT=8787
# Comma separated list of allowed browser origins. Empty = allow all (dev).
CORS_ORIGINS=http://localhost:5173
# Protects POST /api/advisor/ingest (send header x-admin-key)
ADMIN_KEY=change-me
